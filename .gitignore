# 公开仓库采用根目录白名单；本机旧实现、配置、备份和下载目录全部排除。
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/DESIGN.md
!/UPSTREAM.md
!/UPSTREAM.json
!/LICENSE
!/upstream/
!/packages/
!/scripts/

**/node_modules/
**/.tmp/
**/_scratch/
**/.cache/
**/.pnpm-store/
**/lib/
**/dist/
**/out/
**/coverage/
**/.local-state/
**/.env
**/.env.*
**/.credentials*
**/credentials.*
**/secrets.*
**/*.key
**/*.pem
**/*.pfx
**/*.p12
**/*.log
**/*.tgz
**/*.tar
**/*.zip
**/*.sqlite*
**/*.db
**/*.tsbuildinfo
**/.DS_Store
